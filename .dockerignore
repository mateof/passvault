# What must never enter the build context.
#
# node_modules above all: it is large, it is platform-specific, and copying a host's native
# builds into a Linux image produces binaries that load and then crash.
node_modules
**/node_modules

# Runtime state. `data` holds encrypted blobs and the SQLite file; baking somebody's wallet
# into an image is how it ends up on a registry.
data
backups
*.sqlite
*.sqlite-*

# Build output, rebuilt inside the image.
dist
**/dist
*.tsbuildinfo

# Secrets.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

.git
.github
coverage
.vitest
.idea
.vscode
