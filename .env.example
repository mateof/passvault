# PassVault — copy this file to .env and edit it. Never commit the result.
#
# Everything here is optional. With an empty .env the server still starts: SQLite in the
# volume, closed registration, and the first account to register becomes the administrator.
# The variables below exist so a container can arrive already configured instead.

# ─── Keys ────────────────────────────────────────────────────────────────────
#
# MASTER_KEY decrypts everything this installation holds. Generated on first boot and
# written into DATA_DIR if left empty, which is fine on a laptop and wrong on a server:
# a generated key sits next to the database, so anybody who copies the volume gets both.
#
# Generate a pair with:
#   node -e "const c=require('node:crypto');for(const n of ['MASTER_KEY','BLIND_INDEX_KEY'])console.log(n+'='+c.randomBytes(32).toString('base64url'))"
#
# Put both in a password manager before first boot. Losing them makes every encrypted
# value unreadable for ever: no reset, no recovery, no support. That is the design.
MASTER_KEY=
BLIND_INDEX_KEY=

# ─── Where this server lives ─────────────────────────────────────────────────
#
# Everything follows from PUBLIC_URL: the WebAuthn relying party and origin are derived
# from this hostname, so a passkey registered against one value does not work against
# another. Changing it later means registering every passkey again.
PUBLIC_URL=http://localhost:8080
PORT=8080

# Galician, then Spanish and English (gl, es, en).
DEFAULT_LOCALE=gl

# ─── The administrator ───────────────────────────────────────────────────────
#
# The account that owns this installation. Created on boot if it does not exist, and
# promoted if it does — so this also works to hand administration to somebody who
# registered normally. It never demotes anybody and never resets a password: an
# environment variable must not be able to take over an account that already holds data.
#
# ADMIN_EMAIL=admin@example.org
#
# With ADMIN_PASSWORD the account can sign in immediately. Without it, the server mails a
# one-time link to choose a password, prints it in the startup log, and writes it to
# <DATA_DIR>/ADMIN-SETUP-LINK.txt — which is the better option, because the password itself
# is then never in a file or a log. That file is deleted the moment the link is used, and a
# restart issues a fresh one for as long as the account has not been set up.
#
# ADMIN_PASSWORD=
#
# gl, es or en. Sets the language of the mail this account receives.
# ADMIN_LOCALE=gl

# ─── Who may register ────────────────────────────────────────────────────────
#
#   OPEN        anybody who reaches the server can create an account
#   WHITELIST   only the addresses in REGISTRATION_WHITELIST (and any added later)
#   INVITATION  only with a code an administrator issued
#   CLOSED      nobody; the administrator creates accounts from the admin screen
#
# Left empty the server stays CLOSED, and the very first account to register becomes the
# administrator — otherwise a fresh instance could never be configured at all.
#
# REGISTRATION_MODE=INVITATION
#
# Seeds the allow list, so WHITELIST mode works on first boot with nothing to click.
# Separate with commas, spaces or newlines.
# REGISTRATION_WHITELIST=ana@example.org, brais@example.org
#
# Turn password sign-in off when everybody uses Google, Microsoft or a passkey.
# ALLOW_PASSWORD_LOGIN=true
#
# Requires a second factor for everybody. Anybody without an authenticator app gets a code
# by email, so this needs SMTP_URL — without it those accounts cannot sign in at all.
# REQUIRE_SECOND_FACTOR=false
#
# The settings above are applied once, when the database has never had them, and the
# administration screens own them afterwards. Set this to true if you would rather this
# file be the single source of truth and have it rewrite those settings on every restart.
# REGISTRATION_ENFORCE=false

# ─── Database ────────────────────────────────────────────────────────────────
#
# SQLite in the volume by default: no second container, one file to back up. Switching
# engine is this line plus the matching compose profile — the schema is the same on all.
#   postgres://passvault:passvault@postgres:5432/passvault
#   mysql://passvault:passvault@mysql:3306/passvault
# DATABASE_URL=sqlite:/data/passvault.sqlite
# DB_PASSWORD=passvault

# ─── Email ───────────────────────────────────────────────────────────────────
#
# Without it the server cannot send one-time codes, invitations or password-setup links.
# Everything else works.
# SMTP_URL=smtp://user:password@host:587
# MAIL_FROM=passvault@example.org

# ─── Delegated sign-in ───────────────────────────────────────────────────────
#
# The redirect URI to register with the provider is
# <PUBLIC_URL>/api/v1/auth/oidc/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# ── Phone wallets ────────────────────────────────────────────────────────────
#
# Off unless configured, and most installations will leave them off. Neither Apple
# Wallet nor Google Wallet can be entered anonymously: a pass has to be signed by a
# named developer account, which is the point of those systems rather than an obstacle.
# With nothing set here the buttons simply are not offered.
#
# Apple needs a Pass Type ID certificate and key, plus Apple's WWDR intermediate.
# Each can be given inline or as a path to a file, and a file is the better idea: a
# certificate in an environment variable is a certificate in `docker inspect`.
# Signing shells out to `openssl`, which the runtime image already carries.
# APPLE_WALLET_CERT_FILE=/run/secrets/pass-cert.pem
# APPLE_WALLET_KEY_FILE=/run/secrets/pass-key.pem
# APPLE_WALLET_WWDR_FILE=/run/secrets/wwdr.pem
# APPLE_WALLET_PASS_TYPE_ID=pass.org.example.passvault
# APPLE_WALLET_TEAM_ID=ABCDE12345
# APPLE_WALLET_ORGANISATION=PassVault
#
# Google needs an issuer account and a service account key. The pass travels inside a
# JWT this server signs, so there is no API call and nothing registered per ticket.
# GOOGLE_WALLET_ISSUER_ID=3388000000000000000
# GOOGLE_WALLET_SERVICE_ACCOUNT=passvault@example.iam.gserviceaccount.com
# GOOGLE_WALLET_KEY_FILE=/run/secrets/google-wallet-key.pem
# GOOGLE_WALLET_CLASS=passvault-event
